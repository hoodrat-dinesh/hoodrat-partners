# Public application URL, including protocol and no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Comma-separated Google email addresses promoted to admin after sign-in.
ADMIN_EMAILS=owner@example.com

# Shopify Dev Dashboard app settings. The server exchanges these credentials
# for a 24-hour Admin API token and refreshes it automatically.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me
SHOPIFY_API_VERSION=2026-10

# Optional only when webhook signing uses a separately issued secret.
# When omitted, SHOPIFY_CLIENT_SECRET is used for HMAC verification.
SHOPIFY_WEBHOOK_SECRET=

